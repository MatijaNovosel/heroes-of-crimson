              "nextStepId": "2:2"
            },
            {
              "id": "2:1:2",
              "text": "Leave",
              "nextStepId": null
            }
          ]
        },
        {
          "id": "2:2",
          "nextStepId": null,
          "text": "You place your hands upon the pillar, it feels very cold at first but after a brief moment dark thoughts surge into your mind.\nYou feel as if you were walking in a dark, damp room. A set of eyes looks back at you from a corner. \nSnapping back to reality, you hear a creaking noise in the distance.",
          "choices": [
            {
              "id": "2:2:1",
              "text": "Leave",
              "nextStepId": null
            }
          ]
        },
        {
          "id": "2:3",
          "nextStepId": null,
          "text": "You feel as if there is nothing more to this object.",
          "choices": [
            {
              "id": "2:3:1",
              "text": "Leave",
              "nextStepId": null
            }
          ]
        }
      ]
    },
    {
