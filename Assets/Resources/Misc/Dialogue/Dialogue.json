                {
                  "type": "giveXp",
                  "value": 100
                }
              ]
            },
            {
              "id": "1:1:3",
              "text": "Be seeing you!",
              "nextStepId": null
            }
          ]
        },
        {
          "id": "1:2",
          "nextStepId": null,
          "text": "Excellent, here's some grog!",
          "choices": [
            {
              "id": "1:2:1",
              "text": "Awesome, thanks!",
              "nextStepId": null
